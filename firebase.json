{
	"hosting": {
		"public": "packages/1111-web/dist",
		"ignore": [
			"firebase.json",
			"**/.*",
			"**/node_modules/**"
		],
		"rewrites": [
			{
				"source": "/api/**",
				"function": "api"
			},
			{
				"source": "**",
				"destination": "/index.html"
			}
		]
	},
	"functions": {
		"source": "packages/1111-server",
		"runtime": "nodejs22"
	}
}
