{
	"name": "1111-monorepo",
	"private": true,
	"version": "0.0.0",
	"workspaces": ["packages/*"],
	"scripts": {
		"dev": "concurrently -n web,server -c cyan,yellow \"npm run dev:web\" \"npm run dev:server\"",
		"dev:web": "npm run dev --workspace=packages/1111-web",
		"dev:server": "npm run dev --workspace=packages/1111-server",
		"build:web": "npm run build --workspace=packages/1111-web",
		"build:server": "npm run build --workspace=packages/1111-server",
		"build": "npm run build --workspaces --if-present",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"concurrently": "^9.1.2"
	}
}
